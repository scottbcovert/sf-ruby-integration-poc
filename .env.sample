# -----------------------------------------------------------------------------
# Salesforce Connected App Credentials
# -----------------------------------------------------------------------------
# Found in Salesforce Setup -> App Manager -> [Your App] -> Manage Consumer Details
SF_CLIENT_ID="your_consumer_key_here"
SF_CLIENT_SECRET="your_consumer_secret_here"

# -----------------------------------------------------------------------------
# Salesforce JWT Private Key
# -----------------------------------------------------------------------------
# Copy the ENTIRE content of your server.key file here.
# Replace newlines with \n.
SF_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA75... (your actual key content) ...\n-----END RSA PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# Salesforce API Configuration
# -----------------------------------------------------------------------------
# Optional: Salesforce API Version (Defaults to 65.0)
# SF_API_VERSION="65.0" 

# -----------------------------------------------------------------------------
# Rails Configuration
# -----------------------------------------------------------------------------
# Generate a long random string (e.g., run `ruby -e "require 'securerandom'; puts SecureRandom.hex(64)"`)
# This is used to encrypt your session cookies.
SECRET_KEY_BASE="your_random_64_character_hex_string"

# Optional: Local Port (Defaults to 8080 if not set)
# Changes will require updating the Salesforce connected app callback url(s) accordingly
# PORT=8080

# BASE_URL is required for cloud deployments (e.g., https://your-app.onrender.com)
# Defaults to http://localhost:PORT
# Changes will require updating the Salesforce connected app callback url(s) accordingly
# BASE_URL=